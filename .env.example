# Mizigo Marketplace Environment Configuration Template
# Copy this file to .env and configure the variables for your environment.

# Environment mode: development | production | testing
ENVIRONMENT=development

# Database connection URL (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://mizigo:mizigo@localhost:5432/mizigo

# JWT secret key: In production, generate a secure random string (minimum 32 characters)
# e.g., run `openssl rand -hex 32`
SECRET_KEY=replace-with-a-secure-random-32-char-key-in-production

# JWT algorithm (HS256 recommended)
ALGORITHM=HS256

# JWT token expiration window in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
